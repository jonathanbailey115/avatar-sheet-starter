# Copy this file to .env.local and fill it in to play campaigns with friends.
# Leave it out to use local test mode (campaigns only between tabs on one computer).
# Setup steps: docs/SUPABASE_SETUP.md

# Supabase dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> the PUBLISHABLE key (or the legacy "anon" key).
# Never put the secret / service_role key here.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
